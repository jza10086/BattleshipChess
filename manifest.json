{
  "manifest_version": 2,
  "core_api_major": 5,
  "package_version": "1.3.8",
  "id": "gp_battleship",
  "name": "海战棋",
  "kind": "minigame",
  "supported_systems": ["windows"],
  "introduction": "1人依次操作两队测试，2–8人随机均分两队。每人抢选一个目标，双方同回合齐射；多人数队随机产生哑弹，命中+1分。击沉敌方全舰获胜，同时全灭为平局；胜队每人+100分，按总分排名。",
  "entry": "party_round.tscn",
  "player_counts": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "config_schema": "settings.gd",
  "dependencies": {
    "godot_party_default_protocol": "1.0.7"
  },
  "adapters": [
    {
      "id": "standard",
      "protocol": {
        "id": "godot_party_default_protocol",
        "api_major": 1,
        "min_api_minor": 0
      },
      "entry": "adapter.gd"
    }
  ],
  "localization": {
    "supported_locales": [
      "zh_Hans"
    ],
    "fallback_locale": "zh_Hans",
    "translations": {
      "zh_Hans": "i18n/zh_Hans.po"
    }
  }
}
